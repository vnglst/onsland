<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{{title}}}</title>
  <meta name="description" content="{{{description}}}">
  <link rel="canonical" href="https://onsland.koenvangilst.nl">

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#000000">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://onsland.koenvangilst.nl">
  <meta property="og:title" content="{{{title}}}">
  <meta property="og:description" content="{{{description}}}">
  <meta property="og:image" content="https://onsland.koenvangilst.nl/assets/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="https://onsland.koenvangilst.nl">
  <meta name="twitter:title" content="{{{title}}}">
  <meta name="twitter:description" content="{{{description}}}">
  <meta name="twitter:image" content="https://onsland.koenvangilst.nl/assets/twitter-image.png">

  <!-- Fonts -->
  <link rel="stylesheet" href="/fonts/ibm-plex-sans.css">

  <!-- Base CSS -->
  <link rel="stylesheet" href="/shared/base.css">
  <link rel="stylesheet" href="/shared/menu.css">

  <!-- Page-specific CSS -->
  {{#each pageSpecificCss}}
  <link rel="stylesheet" href="{{this}}">
  {{/each}}

  <!-- Analytics -->
  <script defer data-domain="onsland.koenvangilst.nl" src="https://plausible.koenvangilst.nl/js/script.js"></script>

  <!-- Vendor libraries -->
  <script src="/vendor/d3.v7.min.js"></script>
  <script src="/vendor/d3-hexbin.v0.2.min.js"></script>
  <script src="/vendor/topojson-client.v3.min.js"></script>

  <!-- Shared scripts -->
  <script src="/shared/i18n.js"></script>

  <!-- Inline script if provided -->
  {{#if inlineScript}}
  <script>{{{inlineScript}}}</script>
  {{/if}}
</head>
<body>
  {{{body}}}

  {{> footer}}

  <!-- Common scripts that need to be at the end -->
  <script src="/shared/menu.js"></script>
  <script type="module" src="/shared/countries.js"></script>
  <script type="module" src="/shared/translation-utils.js"></script>
  <script type="module" src="/shared/render.js"></script>
  <script src="/shared/page-init.js"></script>

  <!-- Page-specific scripts -->
  {{#each pageSpecificScripts}}
  <script src="{{this}}"></script>
  {{/each}}

  <!-- Page-specific ES6 modules -->
  {{#each pageSpecificModules}}
  <script type="module" src="{{this}}"></script>
  {{/each}}
</body>
</html>
